{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode",
  "description": "AI-powered development tool",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "typecheck:tsc": "bun turbo typecheck:tsc --concurrency=3",
    "check": "bun run lint && bun run typecheck",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.1.0",
      "@effect/platform-node": "4.1.0",
      "@effect/platform-node-shared": "4.1.0",
      "@effect/sql-sqlite-bun": "4.1.0",
      "@effect/sql-sqlite-node": "4.1.0",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.4.3",
      "@hona/strobe": "0.42.0",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@opentui/core": "0.8.4",
      "@opentui/keymap": "0.8.4",
      "@opentui/solid": "0.8.4",
      "@standard-schema/spec": "1.1.0",
      "@kobalte/core": "0.13.13",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@pierre/diffs": "1.6.1",
      "@pierre/highlights": "0.2.0",
      "@solid-primitives/event-listener": "2.4.6",
      "@solid-primitives/resize-observer": "2.2.0",
      "diff": "8.0.4",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.1.0",
      "fast-check": "4.9.0",
      "cross-spawn": "7.0.6",
      "hono": "4.13.13",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "marked": "18.0.11",
      "semver": "7.7.4",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "@typescript/native": "npm:typescript@7.1.0-beta",
      "zod": "4.6.7",
      "remeda": "2.26.0",
      "solid-list": "0.3.0",
      "string-width": "7.2.0",
      "tailwindcss": "4.1.11",
      "vite": "7.3.7",
      "@solidjs/meta": "0.29.4",
      "solid-js": "1.9.17",
      "solid-sonner": "0.3.1",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.0",
    "@hona/strobe": "catalog:",
    "@opencode/client": "workspace:*",
    "@oxlint/plugins": "1.93.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@types/react": "19.2.17",
    "@typescript/native": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.93.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "1.4.4",
    "effect": "catalog:",
    "open": "11.0.4",
    "solid-js": "catalog:"
  },
  "patchedDependencies": {
    "@ai-sdk/openai-compatible@2.0.41": "patches/@ai-sdk%2Fopenai-compatible@2.0.41.patch",
